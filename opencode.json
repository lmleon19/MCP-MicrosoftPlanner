{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "skills": [
    "./skills"
  ],
  "mcp": {
    "servers": {
      "planner": {
        "type": "local",
        "command": [
          "dotnet",
          "src/MCP.MicrosoftPlanner/bin/Release/net10.0/MCP.MicrosoftPlanner.dll"
        ],
        "timeout": {
